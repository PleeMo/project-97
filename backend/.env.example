# Copy to `.env` for local overrides (loaded automatically at startup).
# Every one of these also works as a plain environment variable in production.

# Long random string used to sign JWTs — MUST change before deploying.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Absolute frontend URL baked into generated QR codes (empty = relative path).
FRONTEND_URL=http://localhost:5173

# Swap SQLite for Postgres by changing this one value:
#   postgresql://user:password@localhost:5432/beverage_traceability
DATABASE_URL=sqlite:///./traceability.db

# Salt for hashing client IPs recorded with QR scans (raw IPs are never stored).
IP_HASH_SALT=generate-a-random-string-here
